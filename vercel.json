{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.ts": {
      "includeFiles": "private_storage/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/reader/stream-pdf",
      "destination": "/api/stream-pdf"
    },
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
