# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet or production site is hosted.
# Example: "https://prompt-engineering-ebook-sales-page-three.vercel.app"
APP_URL="https://prompt-engineering-ebook-sales-page-three.vercel.app"

# ==============================================================================
# DIGITAL GOVIND — NOTIFICATION SYSTEM CONFIGURATION
# ==============================================================================

# 1. CRYPTOGRAPHIC LICENSE TOKEN SIGNING (Strict Server-Side Security)
# Required secret used to sign and verify HMAC-SHA256 license tokens for eBook downloads and reader access.
# Generate via: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
LICENSE_SIGNING_SECRET="your_cryptographic_license_signing_secret_here"

# 2. RAZORPAY API AUTHENTICATION (Server-to-Server Verification)
# Obtain from Razorpay Dashboard -> Settings -> API Keys -> Generate Key
# These are kept strictly server-side to fetch and verify payment details via GET /v1/payments/:id
RAZORPAY_KEY_ID="rzp_live_your_key_id_here"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"

# 3. RAZORPAY WEBHOOK VERIFICATION (Strict Server-Side Security)
# Obtain from Razorpay Dashboard -> Settings -> Webhooks -> Add New Webhook
# Set Webhook URL to: https://your-domain.vercel.app/api/razorpay-webhook
# Select Active Events: payment_link.paid, payment.captured, order.paid
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"

# 2. TRANSACTIONAL EMAIL PROVIDER (Resend or SendGrid)
# Primary: Resend API Key (Create at https://resend.com/api-keys)
RESEND_API_KEY="re_1234567890abcdef"

# Backup: SendGrid API Key (Optional fallback if not using Resend)
# SENDGRID_API_KEY="SG.your_sendgrid_api_key_here"

# Sender Email Address (Verified domain on Resend/SendGrid)
NOTIFICATION_FROM_EMAIL="Digital Govind <supportdigitalgovind@gmail.com>"

# 3. TRANSACTIONAL SMS PROVIDER (India DLT Compliant)
# Primary for India: MSG91 Auth Key & DLT Flow/Template ID (https://msg91.com)
MSG91_AUTH_KEY="your_msg91_auth_key_here"
MSG91_FLOW_ID="your_msg91_approved_flow_id_here"
MSG91_SENDER_ID="DGOVND"

# Backup: Twilio SMS (Optional alternative)
# TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
# TWILIO_AUTH_TOKEN="your_twilio_auth_token_here"
# TWILIO_PHONE_NUMBER="+1XXXXXXXXXX"
